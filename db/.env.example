# Variables del servidor de base de datos (db/docker-compose.yml)
POSTGRES_DB=alertas
# Superusuario del contenedor: solo se usa para crear los roles en el primer arranque
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar
# Dueño de las tablas: con él se aplican las migraciones
DB_OWNER_PASSWORD=cambiar
# Rol que usa el backend: no es dueño de las tablas, por eso queda sujeto a RLS.
# Debe coincidir con DB_PASSWORD del .env del backend.
DB_APP_PASSWORD=cambiar
# Dirección donde escucha PostgreSQL. Desarrollo: 127.0.0.1. Producción: IP privada del servidor.
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
