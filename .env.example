# bd (servidor aparte, ver db/)
DB_URL=jdbc:postgresql://localhost:5432/alertas
DB_USERNAME=alertas_app
# igual a DB_APP_PASSWORD de db/.env
DB_PASSWORD=cambiar

# redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=cambiar

# jwt, minimo 32 caracteres (openssl rand -hex 32)
JWT_SECRET=cambiar-por-una-clave-larga-de-minimo-32-caracteres
JWT_EXPIRACION_MINUTOS=480

# urls del front y del superadmin separadas por coma
CORS_ORIGENES=http://localhost:5173,http://localhost:5174

# direccion del front de las instituciones (para armar el enlace de cada colegio)
URL_FRONT=http://localhost:5173

# primer superadmin, se crea al arrancar solo si no existe ninguno
SUPERADMIN_USUARIO=superadmin
SUPERADMIN_CONTRASENA=cambiar-minimo-8
SUPERADMIN_NOMBRES=Superadministrador
